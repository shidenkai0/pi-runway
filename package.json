{
  "name": "pi-runway",
  "version": "0.1.0",
  "description": "Autonomous coding in Pi with mistakes contained: an OS sandbox for every command, one permission gate for every tool call, Jev review for anything your rules don't decide — plus subagents, plan mode and web tools in one install.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "sandbox",
    "auto-review",
    "autonomy",
    "jev"
  ],
  "files": [
    "src",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "scripts/try-local.sh",
    "scripts/try-local.mjs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 test/unit/*.test.ts",
    "eval": "node eval/run.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts",
    "e2e:deps": "mkdir -p .e2e/deps && cd .e2e/deps && (test -f package.json || echo '{\"private\":true}' > package.json) && npm install --no-audit --no-fund @gotgenes/pi-subagents@latest",
    "test:matrix": "node test/matrix/run.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@gotgenes/pi-subagents": "25.0.5",
    "@narumitw/pi-plan-mode": "0.59.4",
    "pi-web-access": "0.46.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "@earendil-works/pi-tui": "1.5.0"
  },
  "bundleDependencies": [
    "@gotgenes/pi-subagents",
    "@narumitw/pi-plan-mode",
    "pi-web-access"
  ]
}
